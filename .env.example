# Password da conta de administração (AURUM) — obrigatória em produção.
# Sem esta variável definida, a app recusa-se a arrancar em produção (por segurança).
ADMIN_PASSWORD=

# Define como "production" no Render. Em desenvolvimento local podes deixar vazio.
NODE_ENV=

# Porta onde o servidor escuta. O Render define isto automaticamente — só é preciso
# em desenvolvimento local se quiseres uma porta diferente do valor por omissão (3200).
PORT=
